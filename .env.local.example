# Supabase MVP toggle (required for frontend auth UI and backend function calls)
VITE_SUPABASE_MVP_ENABLED=true

# Supabase project config (required)
# Example URL format: https://your-project-ref.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional auth redirect override for local testing
# Example: http://localhost:5173
VITE_SUPABASE_AUTH_REDIRECT_URL=http://localhost:5173

# Optional frontend sign-in domain allowlist (comma-separated)
# Default is fdmgroup.com when not set.
VITE_SUPABASE_ALLOWED_EMAIL_DOMAINS=fdmgroup.com



